/*
========================================================================================
    Nextflow config file for testing the ANALYZE workflow
========================================================================================
    Runs the genealogical sorting index on the worked example from Fig. 1 of
    Cummings, Neel & Shaw (2008), where the answer is known: group a is
    monophyletic (gsi = 1) and group b is paraphyletic (gsi = 0.5625).

    Use as follows:
        nextflow run main.nf -profile test_analyze,<docker/singularity/conda> --workflow ANALYZE

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'ANALYZE test profile'
    config_profile_description = 'Minimal test of the gsi workflow against a published worked example'

    max_cpus   = 2
    max_memory = '4.GB'
    max_time   = '1.h'

    workflow         = 'ANALYZE'
    tree             = "${baseDir}/tests/gsi/cummings_fig1.nwk"
    groups           = "${baseDir}/tests/gsi/cummings_groups.tsv"
    gsi_root         = 'as-is'
    gsi_permutations = 999
}
