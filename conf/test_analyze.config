/*
========================================================================================
    Nextflow config file for testing the ANALYZE workflow
========================================================================================
    Runs the whole analyze decision path on the worked example from Fig. 1 of
    Cummings, Neel & Shaw (2008), where the answers are known: group a is
    monophyletic (gsi = 1) and group b is paraphyletic (gsi = 0.5625). Because
    one group is a clade and the other is not, a single run exercises both
    branches of the decision path -- Rosenberg for a, Slatkin-Maddison for b.

    The accompanying alignment is built so every distance is checkable by hand:
    within group a 2 SNPs, within group b 4, and 9 between any a and any b.

    Use as follows:
        nextflow run main.nf -profile test_analyze,<docker/singularity/conda> --workflow ANALYZE

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'ANALYZE test profile'
    config_profile_description = 'Minimal test of the analyze decision path against a published worked example'

    max_cpus   = 2
    max_memory = '4.GB'
    max_time   = '1.h'

    workflow         = 'ANALYZE'
    tree             = "${baseDir}/tests/gsi/cummings_fig1.nwk"
    groups           = "${baseDir}/tests/gsi/cummings_groups.tsv"
    alignment        = "${baseDir}/tests/gsi/cummings_fig1.aln"
    gsi_root         = 'as-is'
    gsi_permutations = 999
}
